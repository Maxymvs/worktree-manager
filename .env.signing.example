# Code-signing / notarization credentials for ./scripts/release-build.sh
#
# Copy to `.env.signing` (gitignored) and fill in your real values:
#     cp .env.signing.example .env.signing
#
# Never commit `.env.signing`. Nothing here belongs in shell history either —
# release-build.sh sources the file itself.

# The exact common name of your "Developer ID Application" certificate as it
# appears in `security find-identity -v -p codesigning`, including the team id
# in parentheses. `./scripts/signing-setup.sh --import` prints this for you.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (ABCDE12345)"

# The Apple ID email of your Apple Developer account.
APPLE_ID="you@example.com"

# Your 10-character Team ID. Find it at
# https://developer.apple.com/account -> Membership details -> Team ID.
# (It is also the string in parentheses in APPLE_SIGNING_IDENTITY.)
APPLE_TEAM_ID="ABCDE12345"

# An APP-SPECIFIC PASSWORD, *not* your Apple ID account password.
# Create one at https://appleid.apple.com -> Sign-In and Security ->
# App-Specific Passwords. Format looks like xxxx-xxxx-xxxx-xxxx.
APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"
